# Add the domestic BigModel key as a GitHub Actions secret named ZAI_API_KEY.
# Never commit the real value.
ZAI_API_KEY=
BIGMODEL_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4.7-flash
GLM_ENABLE_IMAGES=false
MAX_AI_CALLS=30
AI_INPUT_CNY_PER_MILLION=0
AI_OUTPUT_CNY_PER_MILLION=0
AI_SOFT_BUDGET_CNY=35
AI_HARD_BUDGET_CNY=45
