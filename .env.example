# Add API keys as GitHub Actions secrets. DeepSeek is the default provider.
# Never commit the real value.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
AI_PROVIDER=deepseek
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_ENABLE_IMAGES=false
AI_INPUT_CNY_PER_MILLION=3
AI_OUTPUT_CNY_PER_MILLION=9
AI_SOFT_BUDGET_CNY=35
AI_HARD_BUDGET_CNY=45
